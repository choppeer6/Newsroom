ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./newsroom.db
# MySQL deployment: mysql+asyncmy://newsroom:newsroom@localhost:3306/newsroom
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
MAX_REVISION_ROUNDS=2
MAX_INTERFACE_RETRIES=2
MAX_CONCURRENT_TASKS=10
CORS_ORIGINS=["http://localhost:5173"]
